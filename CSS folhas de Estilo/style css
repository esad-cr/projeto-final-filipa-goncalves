----Variavéis CSS----
:root {
  --header-height: 3.5rem;

/====Colors====/
/* Cor de fundo do guia */
--body-color: #F8F9FA; 
 /* Cor da tipografia */   
--title-color: #000000;     
--text-color: #000000;
/* Azul do botão "Ver Projeto" */
--primary-color: #2883CE; 
--secondary-color: #555555; 
--white-color: #ffffff;

/*====Font typography ====*/
/*.5rem = 8px | 1rem = 16px ...*/
/*--body-font: "Roboto", sans-serif;*/
--normal-font-size: 1rem; 
/* 32px (Títulos principais) */
--h1-font-size: 2rem; 
/* 24px (Secções) */
--h2-font-size: 1.5rem;
/* 16px (Body/Texto) */   
--normal-font-size: 1rem;  
  
/*========== Font weight ==========*/
  --font-regular: 400;
  --font-semi-bold: 600;

/*========== z index ==========*/
  --z-tooltip: 10;
  --z-fixed: 100;
}

/**********Estilo Base*********/
 body{
  font-size: 16px;
  font-family: Roboto, sans-serif;
;
  background-color: var(--body-color);
}

h1, h2, h3, h4, h5, h6 {
  font-family: Roboto, sans-serif;
}

p {
  font-size: 16px;
}

small {
  font-size: 0.8rem;
}

strong {
  font-weight: var(--font-semi-bold);
}

ul {
  list-style: none;
  /* Color highlighting when pressed on mobile devices */
  /*-webkit-tap-highlight-color: transparent;*/
}

a {
  text-decoration: none;
  color: var(--secondary-color);
}

a:hover, a:active, a.active {
  color: var(--primary-color);  
}

/*Largura dos elementos que compoem o body*/
/* utilizando classes */
.pageWidth {
  width: 100%;
  max-width: 1680px;
  margin: 0 auto;
  padding: 0 16px;
}

/******Definição da tipografia para mobile ******/
/****portfólioFilipa****/
h1{
  font-size: 2.986 rem;
  font-weight: 700;
  letter-spacing: 0.22 rem;
  line-height: 1.5;
  margin-bottom: 1rem;
  color: var(--title-color);
}
/****sobremim,contactosetc****/
h2{
  font-size: 2.488rem;
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 0.75rem;
  color: var(--title-color);
}
